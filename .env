GOOGLE_MAPS_CENTER_LAT=-7.7489
GOOGLE_MAPS_CENTER_LNG=-41.0294
GOOGLE_MAPS_ZOOM=14

# --- Aplicação ---
APP_NAME=Raízes e Rotas
APP_CITY=Monsenhor Hipólito
